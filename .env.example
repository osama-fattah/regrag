# Copy to .env (never commit .env). Defaults run fully offline.

# Chat model: offline | openai | azure | bedrock
REGRAG_LLM=offline
# e.g. gpt-4o-mini, an Azure deployment name, or anthropic.claude-3-5-haiku-20241022-v1:0
REGRAG_LLM_MODEL=

# Embeddings: hashing | openai | azure | bedrock  (re-run `regrag ingest` after changing)
REGRAG_EMBEDDINGS=hashing
REGRAG_EMBED_MODEL=

REGRAG_TOP_K=6
REGRAG_MAX_REWRITES=1
REGRAG_INDEX_DIR=.index
REGRAG_AUDIT_LOG=logs/audit.jsonl

# Provider credentials are read by the official SDKs:
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=  AZURE_OPENAI_ENDPOINT=  OPENAI_API_VERSION=
# AWS_REGION=eu-west-1   (plus your usual AWS credentials / profile)
